#!/usr/bin/env python3
"""Copy Claude Code sessions between users or machines (rsync over ssh).

  cc-session                                   interactive: pick machines, project and sessions
  cc-session remote add NAME user@host [-i KEY.pem] [--port N]
  cc-session remote list | rm NAME
  cc-session list LOCATION [-p PROJ]
  cc-session delete ID LOCATION [-p PROJ] [-y]
  cc-session ID FROM TO [-p PROJ] [-P DEST_PROJ] [-n]

LOCATION is a Claude config dir: /home/me/.claude, or REMOTE:/root/.claude where REMOTE is a
saved remote name, an ssh config host, or user@host. -i KEY.pem applies to unsaved hosts.
"""
import argparse, curses, glob, json, os, re, shlex, shutil, subprocess, sys, tempfile

SSH_OPTS = shlex.split(os.environ.get("CC_SESSION_SSH_OPTS", ""))
HOSTS_FILE = os.path.expanduser("~/.config/cc-session/hosts.json")
LOCAL, ADD = "@local", "@add"

# Runs on the machine that holds the sessions (locally or through ssh).
REMOTE = r'''
import glob, json, os, sys, time
mode = sys.argv[1]
def readable(c):
    return os.access(os.path.join(c, "projects"), os.R_OK)
if mode == "dirs":
    cands = [os.path.expanduser("~/.claude"), "/root/.claude"] + [
        h + "/.claude" for h in sorted(glob.glob("/home/*") + glob.glob("/Users/*"))]
    seen = set()
    for c in cands:
        if c not in seen and readable(c):
            print(c)
        seen.add(c)
    sys.exit()
if mode == "scan":
    skip = {"/proc", "/sys", "/dev", "/run", "/snap", "/usr", "/lib", "/lib64", "/bin", "/sbin", "/boot", "/mnt"}
    for root, dirs, _ in os.walk("/"):
        if root in skip or root.count("/") > 6:
            dirs[:] = []
            continue
        if os.path.basename(root) == ".claude" and readable(root):
            print(root)
            dirs[:] = []
        dirs[:] = [d for d in dirs if d not in ("node_modules", ".git")]
    sys.exit()
root = os.path.join(os.path.expanduser(sys.argv[2]), "projects")
if mode == "projects":
    for p in sorted(os.listdir(root)) if os.path.isdir(root) else []:
        d = os.path.join(root, p)
        if os.path.isdir(d):
            print("%s\t%d" % (p, sum(f.endswith(".jsonl") for f in os.listdir(d))))
    sys.exit()
if mode == "has":
    print(1 if os.path.isdir(os.path.join(root, sys.argv[3], sys.argv[4])) else "", end="")
    sys.exit()
if mode == "show":
    path = os.path.join(root, sys.argv[3], sys.argv[4] + ".jsonl")
    out, size = [], 0
    def add(t):
        global size
        size += len(t)
        out.append(t)
    for line in open(path, errors="replace") if os.path.isfile(path) else []:
        try:
            m = json.loads(line)
        except Exception:
            continue
        who = m.get("type")
        if who not in ("user", "assistant") or m.get("isMeta"):
            continue
        c = m.get("message", {}).get("content", "")
        if isinstance(c, str):
            c = [{"type": "text", "text": c}]
        for b in c if isinstance(c, list) else []:
            if not isinstance(b, dict):
                continue
            if b.get("type") == "text" and b.get("text", "").strip():
                t = b["text"].strip()
                if who == "user" and t.startswith("<"):
                    continue
                add("## %s\n\n%s\n\n" % ("You" if who == "user" else "Claude", t))
            elif b.get("type") == "tool_use":
                arg = json.dumps(b.get("input", {}), ensure_ascii=False)
                add("> tool: `%s` %s\n\n" % (b.get("name", "?"), arg[:200].replace("\n", " ")))
        if size > 3000000:
            add("\n*(truncated)*\n")
            break
    print(json.dumps("".join(out) or "(no messages)"))
    sys.exit()
if mode == "delete":
    import re, shutil
    proj, sid = sys.argv[3], sys.argv[4]
    if not re.fullmatch(r"[0-9a-f-]{36}", sid) or "/" in proj or proj.startswith("."):
        sys.exit("bad session or project name")
    d = os.path.join(root, proj)
    if not os.path.isfile(os.path.join(d, sid + ".jsonl")):
        sys.exit("no such session: " + sid)
    os.remove(os.path.join(d, sid + ".jsonl"))
    shutil.rmtree(os.path.join(d, sid), ignore_errors=True)
    sys.exit()
d = os.path.join(root, sys.argv[3])
rows = []
for f in os.listdir(d) if os.path.isdir(d) else []:
    if not f.endswith(".jsonl"):
        continue
    sid, path = f[:-6], os.path.join(d, f)
    title = ""
    try:
        title = json.load(open(os.path.join(d, sid, "custom-title.json"))).get("customTitle", "")
    except Exception:
        pass
    if not title:
        try:
            for line in open(path, errors="replace"):
                if '"type":"user"' not in line[:400]:
                    continue
                c = json.loads(line).get("message", {}).get("content", "")
                if isinstance(c, list):
                    c = " ".join(b.get("text", "") for b in c if isinstance(b, dict))
                if c.strip() and not c.lstrip().startswith("<"):
                    title = c.strip().replace("\n", " ")
                    break
        except Exception:
            pass
    st = os.stat(path)
    rows.append((st.st_mtime, sid, st.st_size, title))
for m, sid, size, t in sorted(rows, reverse=True):
    print("\t".join([sid, time.strftime("%m-%d %H:%M", time.localtime(m)), "%.1f" % (size / 1e6), t]))
'''


class Fail(Exception):
    pass


# ---------- remotes ----------

def load_hosts():
    try:
        return json.load(open(HOSTS_FILE))
    except Exception:
        return {}


def save_hosts(hosts):
    os.makedirs(os.path.dirname(HOSTS_FILE), exist_ok=True)
    with open(HOSTS_FILE, "w") as f:
        json.dump(hosts, f, indent=1)
    os.chmod(HOSTS_FILE, 0o600)


def resolve(machine):
    """machine name -> (ssh target or None, ssh options)."""
    if machine in (None, "", LOCAL):
        return None, []
    h = load_hosts().get(machine)
    if not h:
        return machine, list(SSH_OPTS)
    # A remote the user added on purpose: trust its host key on first contact.
    opts = ["-o", "StrictHostKeyChecking=accept-new"]
    if h.get("key"):
        opts += ["-i", h["key"], "-o", "IdentitiesOnly=yes"]
    if h.get("port"):
        opts += ["-p", str(h["port"])]
    return h["target"], opts


def parse(loc):
    """'/path' or 'machine:/path' -> (ssh target or None, path, ssh options)."""
    m = re.match(r"^([^/:]+):(.*)$", loc)
    if not m:
        return None, loc.rstrip("/") or "/", []
    target, opts = resolve(m.group(1))
    return target, m.group(2).rstrip("/") or ".claude", opts


def run_on(machine, *args):
    target, opts = resolve(machine)
    if target:
        cmd = ["ssh", *opts, "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", target, "python3", "-", *args]
        r = subprocess.run(cmd, input=REMOTE, capture_output=True, text=True)
    else:
        r = subprocess.run(["python3", "-c", REMOTE, *args], capture_output=True, text=True)
    if r.returncode:
        raise Fail("%s: %s" % (machine or "this machine", r.stderr.strip() or "failed (needs python3 and key-based ssh)"))
    return [l.split("\t") for l in r.stdout.splitlines() if l]


def query(loc, mode, *args):
    m = re.match(r"^([^/:]+):(.*)$", loc)
    machine, path = (m.group(1), m.group(2) or ".claude") if m else (None, loc)
    return run_on(machine, mode, path, *args)


def delete_one(sid, loc, proj):
    query(loc, "delete", proj, sid)


def loc_of(machine, path):
    return path if machine in (None, "", LOCAL) else "%s:%s" % (machine, path)


def guess_project():
    return re.sub(r"[^A-Za-z0-9]", "-", os.getcwd())


# ---------- copying ----------

def run_rsync(opts, args):
    if subprocess.run(["rsync", "-a", "-e", shlex.join(["ssh", *opts])] + args).returncode:
        raise Fail("rsync failed")


def owner_args(path):
    # Running as root into another user's ~/.claude would leave root-owned 0600 files they cannot read.
    if os.geteuid() != 0 or not os.path.isdir(path):
        return []
    st = os.stat(path)
    return ["--chown=%d:%d" % (st.st_uid, st.st_gid)] if st.st_uid else []


def copy_one(sid, src, dst, proj, dproj, dry=False):
    if not re.fullmatch(r"[0-9a-f-]{36}", sid):
        raise Fail("not a session id: " + sid)
    st, sp, so = parse(src)
    dt, dp, do = parse(dst)
    frm, to = "%s/projects/%s" % (sp, proj), "%s/projects/%s" % (dp, dproj)
    S = lambda name: "%s%s/%s" % (st + ":" if st else "", frm, name)
    D = "%s%s/" % (dt + ":" if dt else "", to)
    extra = (["-n"] if dry else []) + ([] if dt else owner_args(dp))
    tmp = None
    # Not rsync's --mkpath / --ignore-missing-args: macOS ships rsync 2.6.9, which has neither.
    has_data = bool(query(src, "has", proj, sid))
    try:
        if st and dt:  # rsync cannot copy remote to remote; go through this machine
            tmp = tempfile.mkdtemp()
            run_rsync(so, [S(sid + ".jsonl"), tmp + "/"])
            if has_data:
                run_rsync(so, [S(sid), tmp + "/"])
            S = lambda name: "%s/%s" % (tmp, name)
        opts = do if dt else so
        if not dry:
            if dt:
                r = subprocess.run(["ssh", *do, "-o", "BatchMode=yes", dt, "mkdir", "-p", shlex.quote(to)], capture_output=True, text=True)
                if r.returncode:
                    raise Fail("cannot create %s: %s" % (to, r.stderr.strip()))
            else:
                os.makedirs(to, exist_ok=True)
        run_rsync(opts, ["--partial"] + extra + [S(sid + ".jsonl"), D])
        if has_data:
            run_rsync(opts, extra + [S(sid), D])
    finally:
        if tmp:
            shutil.rmtree(tmp, ignore_errors=True)


# ---------- curses UI ----------

def frame(scr, title, hint):
    scr.erase()
    h, w = scr.getmaxyx()
    for i, line in enumerate(title.split("\n")):
        scr.addnstr(i, 0, line, w - 1, curses.A_BOLD if i == 0 else 0)
    scr.addnstr(h - 1, 0, hint, w - 1, curses.A_DIM)
    return h, w, len(title.split("\n")) + 1


def menu(scr, title, items, multi=False, start=0):
    """items: [(label, value)]. Returns the value (a list when multi); None on Esc."""
    hint = "up/down move  space select  a all  enter confirm  esc back" if multi else "up/down move  enter select  esc back"
    cur, top, chosen = start, 0, set()
    while True:
        h, w, y0 = frame(scr, title, hint)
        rows = max(1, h - y0 - 1)
        top = min(max(top, cur - rows + 1), cur)
        for i in range(top, min(len(items), top + rows)):
            mark = ("[x] " if i in chosen else "[ ] ") if multi else ""
            line = ("> " if i == cur else "  ") + mark + items[i][0]
            scr.addnstr(y0 + i - top, 0, line, w - 1, curses.A_REVERSE if i == cur else 0)
        scr.refresh()
        k = scr.getch()
        if k in (curses.KEY_UP, ord("k")):
            cur = max(0, cur - 1)
        elif k in (curses.KEY_DOWN, ord("j")):
            cur = min(len(items) - 1, cur + 1)
        elif k == curses.KEY_PPAGE:
            cur = max(0, cur - rows)
        elif k == curses.KEY_NPAGE:
            cur = min(len(items) - 1, cur + rows)
        elif k == curses.KEY_HOME:
            cur = 0
        elif k == curses.KEY_END:
            cur = len(items) - 1
        elif multi and k == ord(" "):
            chosen ^= {cur}
        elif multi and k == ord("a"):
            chosen = set() if len(chosen) == len(items) else set(range(len(items)))
        elif k in (10, 13, curses.KEY_ENTER):
            if not multi:
                return items[cur][1]
            if chosen:
                return [items[i][1] for i in sorted(chosen)]
        elif k in (27, ord("q")):
            return None


def prompt(scr, title, default=""):
    buf = list(default)
    curses.curs_set(1)
    try:
        while True:
            h, w, y0 = frame(scr, title, "enter confirm  ctrl-u clear  esc back")
            scr.addnstr(y0, 0, "> " + "".join(buf), w - 1)
            scr.move(y0, min(w - 1, 2 + len(buf)))
            scr.refresh()
            k = scr.get_wch()
            if k in ("\n", "\r"):
                return "".join(buf).strip()
            if k == "\x1b":
                return None
            if k in ("\x7f", "\b", curses.KEY_BACKSPACE):
                buf = buf[:-1]
            elif k == "\x15":
                buf = []
            elif isinstance(k, str) and k.isprintable():
                buf.append(k)
    finally:
        curses.curs_set(0)


def notice(scr, text, wait=True):
    frame(scr, text, "press any key" if wait else "")
    scr.refresh()
    if wait:
        scr.getch()


def ssh_keys():
    out = []
    for p in sorted(glob.glob(os.path.expanduser("~/.ssh/*")) + glob.glob(os.path.expanduser("~/*.pem")) + glob.glob(os.path.expanduser("~/Downloads/*.pem"))):
        try:
            if os.path.isfile(p) and "PRIVATE KEY" in open(p, errors="ignore").read(200):
                out.append(p)
        except OSError:
            pass
    return out


def add_remote(scr):
    """Asks for login + key, saves the remote and checks it. Returns its name, or None."""
    login = prompt(scr, "Add remote\nLogin, e.g. root@1.2.3.4 (or user@host:2222)")
    if not login:
        return None
    m = re.match(r"^(.*?)(?::(\d+))?$", login)
    target, port = m.group(1), m.group(2)
    items = [(k, k) for k in ssh_keys()] + [("No key file  (ssh agent / default keys)", ""), ("Other…  (type a path)", "@other")]
    key = menu(scr, "SSH key for %s" % login, items)
    if key is None:
        return None
    if key == "@other":
        key = prompt(scr, "Path to the private key (.pem)")
        if key is None:
            return None
        key = os.path.expanduser(key)
    name = prompt(scr, "Name for this remote", target.split("@")[-1])
    if not name or re.search(r"[/:\s]", name):
        return None
    hosts = load_hosts()
    hosts[name] = {"target": target, **({"key": key} if key else {}), **({"port": int(port)} if port else {})}
    save_hosts(hosts)
    notice(scr, "Connecting to %s …" % target, wait=False)
    try:
        run_on(name, "dirs")
    except Fail:
        hosts.pop(name)
        save_hosts(hosts)
        raise
    return name


def machines():
    """[(label, name)] for this machine, saved remotes and ssh config hosts."""
    items = [("This machine", LOCAL)]
    saved = load_hosts()
    items += [("%s  (%s)" % (n, h["target"]), n) for n, h in saved.items()]
    cfg = os.path.expanduser("~/.ssh/config")
    if os.path.exists(cfg):
        for m in re.finditer(r"(?im)^\s*host\s+(.+)$", open(cfg).read()):
            for h in m.group(1).split():
                if not re.search(r"[*?!]", h) and h != "github.com" and h not in saved:
                    items.append(("%s  (ssh config)" % h, h))
    return items


def pick_machine(scr, title):
    v = menu(scr, title, machines() + [("Add remote…  (login + .pem key, saved for next time)", ADD)])
    return add_remote(scr) if v == ADD else v


def pick_location(scr, title):
    """Machine, then a Claude config dir on it (auto-discovered). Returns a location string or None."""
    while True:
        machine = pick_machine(scr, title + " - which machine?")
        if machine is None:
            return None
        where = machine if machine != LOCAL else "this machine"
        notice(scr, "Looking for Claude data on %s …" % where, wait=False)
        dirs = [r[0] for r in run_on(machine, "dirs")]
        if len(dirs) == 1:
            return loc_of(machine, dirs[0])
        while True:
            items = [(d, d) for d in dirs] + [("Scan the whole machine…", "@scan"), ("Type a path…", "@type")]
            v = menu(scr, title + " - which Claude config dir?" + ("" if dirs else "\n(none found in the usual places)"), items)
            if v is None:
                break
            if v == "@scan":
                notice(scr, "Scanning %s for .claude folders (can take a while) …" % where, wait=False)
                dirs = [r[0] for r in run_on(machine, "scan")]
                continue
            if v == "@type":
                v = prompt(scr, "Path of the .claude dir on that machine")
                if not v:
                    continue
            return loc_of(machine, v)


def pick_project(scr, title, loc, prefer, same_as=None):
    notice(scr, "Loading projects from %s …" % loc, wait=False)
    projs = sorted(query(loc, "projects"), key=lambda r: (r[0] != prefer, r[0]))
    items = [("%s  (%s sessions)" % (n, c), n) for n, c in projs if n != same_as]
    if same_as:
        items.insert(0, ("%s  (same as source)" % same_as, same_as))
    items.append(("Other…  (type a project directory name)", ""))
    v = menu(scr, title, items)
    if v == "":
        v = prompt(scr, title, prefer)
    return v or None


def tui(scr):
    curses.curs_set(0)
    scr.keypad(True)
    step, st = 0, {}
    while True:
        try:
            if step == 0:
                v = pick_location(scr, "Copy FROM")
                if not v:
                    return None
                st = {"src": v}
                step = 1
            elif step == 1:
                v = pick_project(scr, "Project on %s" % st["src"], st["src"], guess_project())
                if not v:
                    step = 0
                    continue
                st["proj"], step = v, 2
            elif step == 2:
                notice(scr, "Loading sessions …", wait=False)
                rows = query(st["src"], "sessions", st["proj"])
                if not rows:
                    notice(scr, "No sessions in %s/projects/%s" % (st["src"], st["proj"]))
                    step = 1
                    continue
                items = [("%s %6s MB  %s  %s" % (r[1], r[2], r[0][:8], r[3][:60]), r[0]) for r in rows]
                v = menu(scr, "Sessions to copy (%d)" % len(items), items, multi=True)
                if v is None:
                    step = 1
                    continue
                st["ids"], step = v, 3
            elif step == 3:
                act = menu(scr, "%d session(s) selected" % len(st["ids"]),
                           [("Copy to another user / machine…", "copy"), ("Delete from %s" % st["src"], "del"), ("Back", "back")])
                if act in (None, "back"):
                    step = 2
                    continue
                if act == "del":
                    if menu(scr, "PERMANENTLY delete %d session(s) from\n  %s/projects/%s ?" % (len(st["ids"]), st["src"], st["proj"]),
                            [("No, keep them", "no"), ("Yes, delete", "yes")]) == "yes":
                        st["delete"] = True
                        return st
                    continue
                v = pick_location(scr, "Copy TO")
                if not v:
                    step = 2
                    continue
                if v == st["src"]:
                    notice(scr, "Destination is the same as the source.")
                    continue
                st["dst"], st["dproj"], step = v, st["proj"], 4
            elif step == 4:
                v = menu(scr, "Copy %d session(s)\n  from %s/projects/%s\n  to   %s/projects/%s" % (
                    len(st["ids"]), st["src"], st["proj"], st["dst"], st["dproj"]),
                    [("Copy", "go"), ("Dry run (copy nothing)", "dry"), ("Change destination project…", "proj"),
                     ("Back", "back"), ("Cancel", "cancel")])
                if v in (None, "back"):
                    step = 3
                elif v == "cancel":
                    return None
                elif v == "proj":
                    p = pick_project(scr, "Project on destination %s" % st["dst"], st["dst"], st["proj"], same_as=st["proj"])
                    st["dproj"] = p or st["dproj"]
                else:
                    st["dry"] = v == "dry"
                    return st
        except Fail as e:
            notice(scr, str(e))
            step = max(0, step - 1)


def interactive():
    st = curses.wrapper(tui)
    if not st:
        print("cancelled")
        return 0
    if st.get("delete"):
        for sid in st["ids"]:
            delete_one(sid, st["src"], st["proj"])
            print("deleted %s from %s" % (sid, st["src"]))
        return 0
    for sid in st["ids"]:
        copy_one(sid, st["src"], st["dst"], st["proj"], st["dproj"], st["dry"])
        print("%s%s: %s -> %s" % ("(dry run) " if st["dry"] else "", sid, st["src"], st["dst"]))
    key = " -i " + shlex.quote(SSH_OPTS[SSH_OPTS.index("-i") + 1]) if "-i" in SSH_OPTS else ""
    print("\nSame thing non-interactively:\n  cc-session%s %s %s %s --project=%s --dest-project=%s" % (
        key, st["ids"][0], st["src"], st["dst"], st["proj"], st["dproj"]))
    return 0


def remote_cmd(a):
    hosts, sub = load_hosts(), a.args[1] if len(a.args) > 1 else ""
    if sub == "list":
        for n, h in hosts.items():
            print("%s  %s%s%s" % (n, h["target"], "  key=" + h["key"] if h.get("key") else "", "  port=%s" % h["port"] if h.get("port") else ""))
    elif sub == "rm" and len(a.args) == 3:
        hosts.pop(a.args[2], None)
        save_hosts(hosts)
    elif sub == "add" and len(a.args) == 4:
        name, target = a.args[2], a.args[3]
        hosts[name] = {"target": target, **({"key": os.path.expanduser(a.identity)} if a.identity else {}), **({"port": a.port} if a.port else {})}
        save_hosts(hosts)
        try:
            found = run_on(name, "dirs")
        except Fail:
            hosts.pop(name)
            save_hosts(hosts)
            raise
        print("saved %s; Claude data found in: %s" % (name, ", ".join(r[0] for r in found) or "(nowhere yet)"))
    else:
        raise Fail("usage: cc-session remote add NAME user@host [-i KEY] [--port N] | list | rm NAME")


def api_cmd(a):
    """Machine-readable queries used by the VS Code extension."""
    cmd, rest = a.args[1] if len(a.args) > 1 else "", a.args[2:]
    if cmd == "machines":
        out = [{"label": l, "name": n} for l, n in machines()]
    elif cmd == "keys":
        out = ssh_keys()
    elif cmd in ("dirs", "scan") and len(rest) == 1:
        out = [r[0] for r in run_on(rest[0], cmd)]
    elif cmd == "projects" and len(rest) == 1:
        out = [{"name": n, "sessions": int(c)} for n, c in query(rest[0], "projects")]
    elif cmd == "sessions" and len(rest) == 1 and a.proj:
        out = [{"id": r[0], "modified": r[1], "mb": r[2], "title": r[3]} for r in query(rest[0], "sessions", a.proj)]
    elif cmd == "show" and len(rest) == 2 and a.proj:
        out = json.loads(query(rest[0], "show", a.proj, rest[1])[0][0])
    elif cmd == "delete" and len(rest) == 2 and a.proj:
        delete_one(rest[1], rest[0], a.proj)
        out = True
    else:
        raise Fail("usage: cc-session api machines | keys | dirs M | scan M | projects LOC | sessions LOC --project=P | show LOC ID --project=P | delete LOC ID --project=P")
    print(json.dumps(out))


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("args", nargs="*")
    ap.add_argument("-p", "--project", dest="proj", help="project dir name (default: from current directory)")
    ap.add_argument("-P", "--dest-project", dest="dproj", help="project dir name on the destination, if different")
    ap.add_argument("-i", "--identity", metavar="KEY", help="ssh private key (.pem) for remote locations")
    ap.add_argument("--port", type=int, help="ssh port (with 'remote add')")
    ap.add_argument("-y", "--yes", action="store_true", help="confirm 'delete' without asking")
    ap.add_argument("-n", dest="dry", action="store_true", help="dry run")
    a = ap.parse_args()
    if a.identity:
        SSH_OPTS[:0] = ["-i", os.path.expanduser(a.identity), "-o", "IdentitiesOnly=yes"]
    try:
        if not a.args:
            if not sys.stdin.isatty():
                ap.print_help()
                return 1
            return interactive()
        proj = a.proj or guess_project()
        if a.args[0] == "api":
            api_cmd(a)
        elif a.args[0] == "remote":
            remote_cmd(a)
        elif a.args[0] == "list" and len(a.args) == 2:
            for r in query(a.args[1], "sessions", proj):
                print("%s  %s  %6s MB  %s" % (r[0], r[1], r[2], r[3][:70]))
        elif a.args[0] == "delete" and len(a.args) == 3:
            if not a.yes and (not sys.stdin.isatty() or input("Permanently delete %s from %s? [y/N] " % (a.args[1], a.args[2])).lower() != "y"):
                raise Fail("not deleted (pass -y to confirm)")
            delete_one(a.args[1], a.args[2], proj)
            print("deleted %s from %s" % (a.args[1], a.args[2]))
        elif len(a.args) == 3:
            copy_one(a.args[0], a.args[1], a.args[2], proj, a.dproj or proj, a.dry)
            print("copied %s: %s -> %s" % (a.args[0], a.args[1], a.args[2]))
        else:
            ap.print_help()
            return 1
    except Fail as e:
        print("error:", e, file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
